# Umi runtime integration. Charging starts inhibited pending telemetry review.
config BATTERY_MISEED_QCOM_FG
	tristate "MiSeed Qualcomm FG port (Umi runtime)"
	depends on SPMI && POWER_SUPPLY && OF
	help
	  Qualcomm FG driver from colorgarden/umi-mainline. Gen4 telemetry
	  are read from inherited peripheral state; no profile SRAM is loaded.

config CHARGER_MISEED_PM8150B
	tristate "MiSeed PM8150B charger port (Umi runtime)"
	depends on SPMI && POWER_SUPPLY && IIO && OF
	help
	  SMB5 driver from colorgarden/umi-mainline with Umi safety gates.
	  Charge starts inhibited, with a bounded insertion test and
	  misaka-derived SOC hysteresis. No fast-charge pump is enabled.

config CHARGER_MISEED_UMI_PPS
	tristate "MiSeed Umi guarded BQ25970 PPS controller"
	depends on I2C && OF && TYPEC_TCPM && TYPEC_QCOM_PMIC
	depends on CHARGER_MISEED_PM8150B && BATTERY_MISEED_QCOM_FG
	select REGMAP_I2C
	help
	  Bounded, explicitly armed PPS charge-pump testing using mainline TCPM.
	  Requires a qualified standalone BQ25970, fault IRQ, sense resistor
	  and a complete enabled protection profile. Board nodes remain disabled
	  until GPIO, PMIC ownership and board calibration are independently
	  reviewed. Probe never enables the pump or requests a PPS contract.
