# Minimal arm64 allnoconfig fragment for a Qualcomm SM8250 board L2 build.
CONFIG_ARCH_QCOM=y
# Match the Umi mainline bring-up profile; avoid the allnoconfig 52-bit defaults.
CONFIG_ARM64_VA_BITS_48=y
CONFIG_ARM64_PA_BITS_48=y
CONFIG_OF=y
CONFIG_OF_OVERLAY=y
CONFIG_PM=y
CONFIG_CPU_IDLE=y
CONFIG_ARM_PSCI_CPUIDLE=y
CONFIG_ARM_PSCI_CPUIDLE_DOMAIN=y
CONFIG_PINCTRL_MSM=y
CONFIG_PINCTRL_SM8250=y
CONFIG_COMMON_CLK_QCOM=y
CONFIG_SM_GCC_8250=y
CONFIG_QCOM_CLK_RPMH=y
CONFIG_QCOM_RPMHPD=y
CONFIG_QCOM_GDSC=y
CONFIG_HWSPINLOCK=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_LLCC=y
CONFIG_INTERCONNECT=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_SM8250=y
CONFIG_INTERCONNECT_QCOM_OSM_L3=y
CONFIG_IOMMU_SUPPORT=y
CONFIG_ARM_SMMU=y
CONFIG_SPMI=y
# The SM8250 SPMI peripheral IRQ is routed through PDC.
CONFIG_QCOM_PDC=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_MFD_SPMI_PMIC=y
# Runtime port: charge starts inhibited; arm only after telemetry validation.
CONFIG_MODULES=y
CONFIG_POWER_SUPPLY=y
CONFIG_IIO=y
CONFIG_BATTERY_MISEED_QCOM_FG=y
CONFIG_CHARGER_MISEED_PM8150B=y
CONFIG_QCOM_SPMI_ADC5=y
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_BINFMT_ELF=y
CONFIG_QCOM_GENI_SE=y
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_MEMFD_CREATE=y
CONFIG_FILE_LOCKING=y
CONFIG_PRINTK=y
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_FONTS=y
CONFIG_FONT_TER16x32=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_GADGET=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_GADGET=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_DEBUG_FS=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_RPMH=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_CONFIGFS_FS=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_U_SERIAL_CONSOLE=y
CONFIG_CMDLINE="console=ttyMSM0,115200n8 console=tty0 loglevel=8 keep_bootcon earlycon pd_ignore_unused clk_ignore_unused regulator_ignore_unused fbcon=font:TER16x32,rotate:3 rdinit=/init"
CONFIG_CMDLINE_FORCE=y

# Compile PPS integration; its board nodes remain disabled pending qualification.
# TCPM requires the USB core; DWC3 remains gadget-only, no host HCD is selected.
CONFIG_USB=y
CONFIG_I2C=y
CONFIG_I2C_QCOM_GENI=y
CONFIG_TYPEC=y
CONFIG_TYPEC_TCPM=y
CONFIG_TYPEC_QCOM_PMIC=y
CONFIG_CHARGER_MISEED_UMI_PPS=y
CONFIG_REGULATOR_QCOM_USB_VBUS=y
