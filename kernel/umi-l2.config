# Minimal arm64 defconfig extension for a Qualcomm SM8250 board DTB/Image build.
CONFIG_ARCH_QCOM=y
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_PRINTK=y
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
