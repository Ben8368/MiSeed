# Optional native display; default rescue retains simpledrm.
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_7NM_PHY=y
CONFIG_SM_DISPCC_8250=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DRM_PANEL_XIAOMI_UMI_CSOT=y
# Retain early DRM/DSI probe messages for the unfiltered rescue snapshot.
CONFIG_LOG_BUF_SHIFT=20
CONFIG_PRINTK_TIME=y
